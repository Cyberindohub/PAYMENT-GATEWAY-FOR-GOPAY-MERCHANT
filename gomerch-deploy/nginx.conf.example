# ==========================================================================
# Contoh blok Nginx untuk situs domainmu (aaPanel: Website > Settings > Config)
# Tempel bagian location di bawah ke dalam server { ... } situs Anda.
# ==========================================================================

# API -> backend FastAPI (uvicorn di port 8001)
location /api/ {
    proxy_pass http://127.0.0.1:8001;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
}

# React SPA -> file statis hasil build
location / {
    root /www/wwwroot/domainmu/frontend-build;
    try_files $uri $uri/ /index.html;
}
